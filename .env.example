# Required: generate with: openssl rand -base64 32
# Save this value! Changing it invalidates all sessions and auth data.
BETTER_AUTH_SECRET=

# Required: admin UI password
UI_PASSWORD=changeme

# Optional: admin UI username (default: admin)
# UI_USERNAME=admin

# Public URL of this instance. Required when running behind a reverse proxy.
# Automatically configures CORS allowed origins and auth callback URL.
# APP_BASE_URL=https://archmax.example.com

# Optional: MongoDB connection string.
# In Docker, omit this to use the embedded MongoDB instance.
# For local development, set this to your MongoDB instance.
# MONGODB_URI=mongodb://localhost:27017/archmax

# Optional: external Redis. Omit to use the embedded instance in Docker.
# REDIS_URL=redis://localhost:6379

# Optional: encryption key for storing credentials and API keys at rest.
# When set, database connection passwords, test agent API keys, and GitHub
# Personal Access Tokens are encrypted with AES-256-GCM before storage.
# Required for GitHub integration (push/pull to remote repositories).
# Without this, credentials are stored in plaintext.
# Generate with: openssl rand -base64 32
# ENCRYPTION_KEY=

# AI Agent (required for Semantic Model Builder, Testing Playground, and title generation).
# Supports OpenRouter (default), OpenAI, Azure OpenAI, Ollama, or any OpenAI-compatible endpoint.
# Without AGENT_API_KEY, agent features will be unavailable.
AGENT_API_KEY=your-api-key

# Base URL for the AI provider. Change when using a provider other than OpenRouter.
# AGENT_API_BASE_URL=https://openrouter.ai/api/v1

# Model identifier. Must match your provider's naming convention.
# AGENT_MODEL=anthropic/claude-sonnet-4.6

# Per-request timeout for LLM API calls, in seconds (default: 300).
# Increase if you see frequent "Request timed out" errors from OpenRouter.
# AGENT_REQUEST_TIMEOUT=300

# Max retries for transient LLM failures (timeouts, 429s, 5xx). Default: 3.
# AGENT_MAX_RETRIES=3

# DuckDB query timeout in milliseconds (default: 30000).
# Applies to MCP, agent, data browser, and connection test queries.
# On timeout, the DuckDB query is cancelled via interrupt().
# QUERY_TIMEOUT_MS=30000

# How long (ms) to wait for an interrupted query to actually unwind after a
# timeout/cancellation before giving up (default: 30000). The connection is
# only torn down once the native query has stopped, so it is never closed out
# from under a live operation (which can crash the worker process). A query
# that ignores the interrupt past this window has its teardown deferred rather
# than blocking the run forever.
# QUERY_INTERRUPT_GRACE_MS=30000

# Max concurrent DuckDB queries per project (default: 10).
# Limits parallel queries to prevent resource exhaustion.
# Additional requests wait up to QUERY_TIMEOUT_MS for a slot.
# MAX_CONCURRENT_QUERIES=10

# Enable the custom (unsigned) Firebird connection type (default: disabled).
# When set to true, the `firebird` connection type becomes available and every
# DuckDB instance starts with allow_unsigned_extensions so the custom Firebird
# extension can load. This is the only switch that turns on unsigned-extension
# support; the federation console never installs unsigned extensions from
# arbitrary custom sources.
# SECURITY: the Firebird extension is unsigned and runs arbitrary native code.
# Only enable it when the Firebird extension source is trusted.
# DUCKDB_ENABLE_CUSTOM_FIREBIRD=false
