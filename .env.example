# Required — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required — admin UI password
UI_PASSWORD=changeme

# Optional — admin UI username (default: admin)
# UI_USERNAME=admin

# Optional — external MongoDB. Omit to use the embedded instance (Docker only).
# MONGODB_URI=mongodb://localhost:27017/archsem

# Optional — external Redis. Omit to use the embedded instance (Docker only).
# REDIS_URL=redis://localhost:6379

# Optional — AI agent configuration
# AGENT_API_BASE_URL=https://openrouter.ai/api/v1
# AGENT_API_KEY=your-api-key
# AGENT_MODEL=anthropic/claude-sonnet-4
