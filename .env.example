# Database
MONGODB_URI=mongodb://localhost:27017/semlayer

# API server
PORT=3000

# CORS
CORS_ORIGINS=http://localhost:5173

# MCP bearer token (auto-generated if not set)
MCP_BEARER_TOKEN=
MCP_RATE_LIMIT_MAX=120

# Better Auth secret (min 32 chars — generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Admin UI credentials (used to seed the initial admin user)
UI_USERNAME=admin
UI_PASSWORD=changeme
