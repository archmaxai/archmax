# Database
MONGODB_URI=mongodb://localhost:27017/archmax

# API server
PORT=3000

# CORS
CORS_ORIGINS=http://localhost:5173

# Semantic model storage directory (absolute, or relative to monorepo root; defaults to data/projects)
SEMLAYER_DATA_DIR=data/projects

# MCP rate limiting (per IP, per 60s window)
MCP_RATE_LIMIT_MAX=120

# Better Auth base URL (defaults to http://localhost:PORT; set to your public URL in production)
AUTH_BASE_URL=

# Better Auth secret (min 32 chars — generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Admin UI credentials (used to seed the initial admin user)
UI_USERNAME=admin
UI_PASSWORD=changeme

# Deep Agent — any OpenAI-compatible endpoint (OpenRouter, OpenAI, Ollama, etc.)
AGENT_API_BASE_URL=https://openrouter.ai/api/v1
AGENT_API_KEY=
AGENT_MODEL=anthropic/claude-sonnet-4
# Title generation model — cheap/fast model for conversation titles
AGENT_TITLE_MODEL=anthropic/claude-haiku-4-5-20250929

# Redis (optional — enables BullMQ worker queue; without it the agent runs in-process)
REDIS_URL=
# Number of concurrent agent jobs per worker (default: 5)
WORKER_CONCURRENCY=5

# Testing — max iterations for playground and batch test agents (default: 100)
TEST_AGENT_MAX_ITERATIONS=100
