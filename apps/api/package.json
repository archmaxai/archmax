{
  "name": "@archmax/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./mcp/archmax-server": "./src/mcp/archmax-server.ts"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:db-rename": "node --import tsx src/scripts/migrate-db-rename.ts",
    "migrate:view-query": "node --import tsx src/scripts/migrate-view-query.ts"
  },
  "dependencies": {
    "@archmax/core": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "@langchain/core": "^1.2.9",
    "@langchain/openai": "^1.5.10",
    "@modelcontextprotocol/hono": "2.0.0-alpha.2",
    "@modelcontextprotocol/server": "2.0.0-alpha.2",
    "better-auth": "^1.7.1",
    "deepagents": "^1.13.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.3",
    "js-yaml": "^4.1.1",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "tsx": "^4.23.12",
    "typescript": "6.0.3"
  }
}
