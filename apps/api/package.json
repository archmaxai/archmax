{
  "name": "@archmax/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./mcp/archmax-server": "./src/mcp/archmax-server.ts"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:db-rename": "node --import tsx src/scripts/migrate-db-rename.ts"
  },
  "dependencies": {
    "@archmax/core": "workspace:*",
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.7.6",
    "@langchain/core": "^1.1.40",
    "@langchain/openai": "^1.4.4",
    "@modelcontextprotocol/hono": "2.0.0-alpha.2",
    "@modelcontextprotocol/server": "2.0.0-alpha.2",
    "better-auth": "^1.6.5",
    "deepagents": "^1.9.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.14",
    "js-yaml": "^4.1.1",
    "mongodb": "^7.1.1",
    "mongoose": "^9.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
