{
  "name": "@archmax/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./mcp/archmax-server": "./src/mcp/archmax-server.ts"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:db-rename": "node --import tsx src/scripts/migrate-db-rename.ts",
    "migrate:view-query": "node --import tsx src/scripts/migrate-view-query.ts"
  },
  "dependencies": {
    "@archmax/core": "workspace:*",
    "@hono/node-server": "^2.0.0",
    "@hono/zod-validator": "^0.7.6",
    "@langchain/core": "^1.1.42",
    "@langchain/openai": "^1.4.5",
    "@modelcontextprotocol/hono": "2.0.0-alpha.2",
    "@modelcontextprotocol/server": "2.0.0-alpha.2",
    "better-auth": "^1.6.9",
    "deepagents": "^1.9.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.15",
    "js-yaml": "^4.1.1",
    "mongodb": "^7.2.0",
    "mongoose": "^9.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "tsx": "^4.19.2",
    "typescript": "6.0.3"
  }
}
